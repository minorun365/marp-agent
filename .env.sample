# ローカル開発で使う設定です。デプロイ先の設定は cdk.json の context を使います。

# 認証をスキップしてUIだけ動かす（npm run dev:ui が自動で有効にします）
VITE_USE_MOCK=false

# Tavily APIキー（カンマ区切りで複数キー対応、レートリミット時に自動フォールバック）
# デプロイ後の環境では Secrets Manager の pawapo/tavily-api-keys を読むため、ここは不要です
TAVILY_API_KEYS=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx,tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E2Eテストで使うログインユーザー
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123!

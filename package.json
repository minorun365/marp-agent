{
  "name": "marp-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "@aws-cdk/toolkit-lib": "1.14.0",
    "@smithy/core": "3.32.0"
  },
  "scripts": {
    "dev": "node infra/scripts/start-dev.mjs",
    "dev:ui": "VITE_USE_MOCK=true vite",
    "dev:auth": "VITE_USE_MOCK=true VITE_SHOW_AUTH=true vite",
    "dev:vite": "vite",
    "dev:full": "node infra/scripts/start-full.mjs",
    "dev:web": "npm run build && node infra/web/server.mjs",
    "dev:agent": "cdkd local start-agentcore PawapoAgent/Runtime --watch --port 8081 --no-verify-auth",
    "dev:cloudfront": "cdkd local start-cloudfront PawapoWeb/Distribution --watch --port 8080 --from-state",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "infra:synth": "cdkd synth",
    "infra:bootstrap": "cdkd bootstrap --region us-east-1",
    "infra:diff": "cdkd diff",
    "infra:dry-run": "cdkd deploy --all --dry-run",
    "infra:deploy": "cdkd deploy --full-wait",
    "infra:state": "cdkd state show PawapoWeb --stack-region us-east-1",
    "infra:drift": "cdkd drift --all",
    "prod:cutover:check": "node --env-file-if-exists=.env.production.local infra/scripts/cutover-production.mjs",
    "prod:cutover": "node --env-file-if-exists=.env.production.local infra/scripts/cutover-production.mjs --apply",
    "prod:rollback:check": "node --env-file-if-exists=.env.production.local infra/scripts/rollback-production.mjs",
    "prod:rollback": "node --env-file-if-exists=.env.production.local infra/scripts/rollback-production.mjs --apply",
    "copy-themes": "cp src/themes/*.css amplify/agent/runtime/",
    "test": "vitest run",
    "sandbox": "npm run copy-themes && BRANCH=$(git branch --show-current | tr '/' '-') && npx ampx sandbox --identifier \"sb-${BRANCH}\" --profile sandbox",
    "setup:git-hooks": "git config --local core.hooksPath .githooks",
    "push:approve": "bash scripts/approve-push-scope.sh"
  },
  "dependencies": {
    "@aws-cdk/aws-bedrock-agentcore-alpha": "^2.236.0-alpha.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1063.0",
    "@aws-sdk/client-sts": "^3.1063.0",
    "@marp-team/marp-core": "^4.2.0",
    "@marp-team/marpit-svg-polyfill": "^2.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "aws-amplify": "^6.20.0",
    "deploy-time-build": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.20.0",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@eslint/js": "^9.39.1",
    "@go-to-k/cdkd": "0.282.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "aws-cdk": "2.1136.0",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.4.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.2",
    "vitest": "^4.0.18"
  }
}

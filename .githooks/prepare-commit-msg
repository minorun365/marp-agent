#!/usr/bin/env bash
# 公開版（marp-agent）と KAG社内版（marp-agent-kag）の同期は merge 方式に一本化している。
# cherry-pick は使わないので、ここで止める（2026-08-22 に方針を確定）。

set -euo pipefail

if [[ "${ALLOW_CHERRY_PICK:-}" == "1" ]]; then
  exit 0
fi

cherry_pick_head=$(git rev-parse --git-path CHERRY_PICK_HEAD)
if [[ -f "$cherry_pick_head" ]]; then
  cat >&2 <<'MSG'

  ⛔ cherry-pick は使いません（merge 方式に一本化しています）

  KAG社内版は公開版から280コミット以上先行しているため、必要な変更を
  1つずつ拾い上げる方式は破綻します。公開版の変更は merge で流してください。

    公開版で作業した後:  sync-to-kag スキルを実行する
    KAG版で直接やる場合:  git fetch upstream && git merge upstream/main

  逆方向（KAG版 → 公開版）のマージもしません。KAG版には社内固有のテーマ・
  ドメイン・移行元リソースIDが入っており、公開リポジトリへ社内情報が出る
  経路になるためです。公開版にも当てはまる変更は、公開版側で書き直します。

  いま元に戻すには：
      git cherry-pick --abort

  それでも通す場合のみ：
      ALLOW_CHERRY_PICK=1 git cherry-pick <コミット>

MSG
  exit 1
fi

exit 0

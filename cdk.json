{
  "app": "npx tsx infra/bin/pawapo.ts",
  "output": "cdk.out",
  "watch": {
    "include": [
      "infra/**/*.ts",
      "infra/web/**",
      "agent/**",
      "infra/lambda/auth/**",
      "src/**"
    ],
    "exclude": [
      "node_modules",
      "cdk.out",
      "dist",
      ".git"
    ]
  },
  "context": {
    "appDomain": "pawapo.minoruonda.com",
    "previewDomain": "preview.pawapo.minoruonda.com",
    "cutoverWildcardDomain": "*.minoruonda.com",
    "@aws-cdk/core:validateAgainstDefaultRules": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "cdkd": {
      "statePrefix": "pawapo"
    }
  }
}
